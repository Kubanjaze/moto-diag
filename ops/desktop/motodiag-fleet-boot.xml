<?xml version="1.0" encoding="UTF-8"?>
<!-- Phase 388: the fleet's own holder of the VM. The same task as
     motodiag-wsl-boot.xml (Phase 382), under its own name, so the fleet
     dispatcher's unit runs whether or not the API's task exists. At startup,
     whether or not anyone signs in, start Ubuntu and hold it up; systemd
     inside starts motodiag-fleet.service. Registered elevated with
     Register-ScheduledTask -TaskPath "\motodiag\" -TaskName "fleet-boot"
     -Xml ((Get-Content <this file> -Raw) -replace '^<\?xml[^>]*\?>\s*',''):
     schtasks /Create /XML refuses this UTF-8 file, "(1,40): unable to
     switch the encoding" (the operator, of the same failure in Phase 382). -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>moto-diag (Phase 388): keep Ubuntu-26.04 running from boot so the fleet dispatcher is always on.</Description>
    <URI>\motodiag\fleet-boot</URI>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
      <Delay>PT30S</Delay>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-3641038677-726254276-1902698067-1001</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wsl.exe</Command>
      <Arguments>-d Ubuntu-26.04 --exec /bin/sleep infinity</Arguments>
    </Exec>
  </Actions>
</Task>
